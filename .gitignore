# ---- Secrets : ne JAMAIS commiter ----
.env
*.env
!.env.example
infra/mosquitto/passwd
firmware/include/secrets.h
firmware/*/secrets.h
firmware/include/ca_cert.h
firmware/include/certs.h
firmware/*/certs.h
security/certs/*
!security/certs/.gitkeep
*.key
*.pem
*.p12
*.pfx

# ---- Modèles et médias lourds (stockés hors dépôt) ----
ai/vision/models/*
!ai/vision/models/.gitkeep
ai/anomaly/models/*
!ai/anomaly/models/.gitkeep
ai/anomaly/data/*
!ai/anomaly/data/.gitkeep
ai/vision/data/*
!ai/vision/data/.gitkeep
*.pt
*.onnx
*.mp4
*.mov
*.mkv

# ---- Builds et dépendances ----
node_modules/
dashboard/dist/
.pio/
build/
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.ruff_cache/

# ---- Système / éditeurs ----
.DS_Store
Thumbs.db
*.log
.idea/

