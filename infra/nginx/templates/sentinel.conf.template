# Bloc server de Sentinel-X. ${VISION_UPSTREAM} est remplacé au démarrage du conteneur nginx.
server {
  listen 8443 ssl;
  http2 on;
  server_name sentinel-pc localhost _;

  ssl_certificate     /etc/nginx/certs/server.crt;
  ssl_certificate_key /etc/nginx/certs/server.key;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options    "nosniff" always;
  add_header X-Frame-Options           "DENY" always;
  add_header Referrer-Policy           "no-referrer" always;
  # Le dashboard ne charge rien d'extérieur : tout script ou appel vers un autre site est bloqué par le navigateur
  add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  add_header Permissions-Policy        "camera=(), microphone=(), geolocation=()" always;

  client_max_body_size 1m;

  # Dashboard (fichiers statiques compilés)
  root /usr/share/nginx/html;
  location / { try_files $uri $uri/ /index.html; }

  # API REST
  location /api/ {
    limit_req zone=api burst=40 nodelay;
    set $api_upstream http://api:8000;
    proxy_pass $api_upstream;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  # WebSocket temps réel (WSS)
  location /ws {
    set $api_upstream http://api:8000;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
  }

  # Vérification des tickets vidéo : réservée à nginx (auth_request), jamais appelée depuis l'extérieur
  location = /api/v1/video/check { return 404; }
  location = /_video_auth {
    internal;
    set $api_upstream http://api:8000;
    proxy_pass $api_upstream/api/v1/video/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Real-IP      $remote_addr;
  }

  # Flux vidéo MJPEG annoté (service vision), ouvert seulement avec un ticket de 60 s délivré par l'API au dashboard
  # connecté. Adresse fixée au démarrage : /etc/hosts (host.docker.internal sous Docker Desktop) ou DNS de Docker.
  location = /video {
    auth_request /_video_auth;
    access_log off;                       # le ticket est dans l'URL : pas dans les journaux
    proxy_pass http://${VISION_UPSTREAM}/video;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
  }
}
