# Copier en .env (jamais commité) puis remplacer toutes les valeurs CHANGE_ME.

# --- Mode de lancement -------------------------------------------------------
# Lundi (MQTT en clair 1883) :
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
MQTT_PORT=1883
MQTT_TLS=false
# Dès mardi (TLS) : remplacer les trois lignes ci-dessus par
# COMPOSE_FILE=docker-compose.yml
# MQTT_PORT=8883
# MQTT_TLS=true

# Profils actifs : vide = socle (mosquitto + postgres) ; puis "app" ; puis "app,ai"
COMPOSE_PROFILES=

# --- Base de données ---------------------------------------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME

# --- MQTT (mêmes mots de passe que dans infra/mosquitto/passwd) --------------
MQTT_API_PASSWORD=CHANGE_ME
MQTT_ANOMALY_PASSWORD=CHANGE_ME

# --- API ---------------------------------------------------------------------
API_KEY=CHANGE_ME_32_CARACTERES_MINIMUM

# --- Certificats : GID du groupe qui peut lire les clés (voir security/README)
CERTS_GID=2000

# --- Vision ------------------------------------------------------------------
CAMERA_DEVICE=/dev/video0
VISION_MODEL=yolov8n_ncnn_model
VISION_IMGSZ=320
VISION_CONF=0.5
VISION_COOLDOWN=10
