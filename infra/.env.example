# Copier en .env (jamais commité) puis remplacer toutes les valeurs CHANGE_ME.

# --- Mode de lancement -------------------------------------------------------
# Lundi : MQTT en clair 1883 authentifié (boîtier et services)
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
MQTT_PORT=1883
MQTT_TLS=false
# Dès mardi (TLS) : remplacer les trois lignes ci-dessus par
# COMPOSE_FILE=docker-compose.yml
# MQTT_PORT=8884
# MQTT_TLS=true
# Fichier Mosquitto : mosquitto.tls.conf (TLS) puis mosquitto.mtls.conf (TLS mutuel)
MOSQUITTO_CONF=mosquitto.tls.conf

# Profils actifs : vide = socle (mosquitto + postgres) ; puis "app" ; puis "app,ai"
# ("vision" en plus uniquement sur un hôte Linux : sous Windows, voir VISION_CAMERA)
COMPOSE_PROFILES=

# --- Profil de site (fichier dans config/) -----------------------------------
SITE_PROFILE_FILE=site.example.yml

# --- Base de données ---------------------------------------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME

# --- MQTT (mêmes mots de passe que dans infra/mosquitto/passwd) --------------
MQTT_API_PASSWORD=CHANGE_ME
MQTT_ANOMALY_PASSWORD=CHANGE_ME

# --- API ---------------------------------------------------------------------
API_KEY=CHANGE_ME_32_CARACTERES_MINIMUM        # services -> POST /api/v1/alerts
OPERATOR_TOKEN=CHANGE_ME_32_CARACTERES_MINIMUM # interface opérateur
WEBHOOK_URL=                                   # optionnel, incidents vers une supervision externe

# --- Certificats : GID du groupe qui peut lire les clés (voir security/README)
CERTS_GID=2000

# --- Vision ------------------------------------------------------------------
VISION_MODEL=yolov8n_ncnn_model
# PC serveur Windows (ai/vision/run-windows.ps1) : index OpenCV de la webcam
VISION_CAMERA=0
# Hôte Linux uniquement (profil "vision") : périphérique de la webcam
CAMERA_DEVICE=/dev/video0
