# Copier en .env (jamais commité) puis remplacer toutes les valeurs CHANGE_ME.
#   PowerShell :  copy infra\.env.example infra\.env
# Mots de passe : 20 caractères minimum. Générer par exemple avec
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Séparateur de COMPOSE_FILE : ":" partout (Windows utilise ";" par défaut) ---
COMPOSE_PATH_SEPARATOR=:

# --- Mode de lancement -------------------------------------------------------
# Socle : MQTT en clair 1883 authentifié (boîtier et services)
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
MQTT_PORT=1883
MQTT_TLS=false
# Dès que les certificats de Lisa sont prêts (TLS) : remplacer les trois lignes ci-dessus par
# COMPOSE_FILE=docker-compose.yml
# MQTT_PORT=8884
# MQTT_TLS=true
# Linux ou Raspberry Pi (vision dans un conteneur) : ajouter :docker-compose.linux.yml à COMPOSE_FILE
# Fichier Mosquitto : mosquitto.tls.conf (TLS) puis mosquitto.mtls.conf (TLS mutuel)
MOSQUITTO_CONF=mosquitto.tls.conf

# Profils actifs : vide = socle (mosquitto + postgres) ; puis "app" ; puis "app,ai"
COMPOSE_PROFILES=

# --- Profil de site (fichier dans config/) -----------------------------------
SITE_PROFILE_FILE=site.example.yml

# --- Base de données ---------------------------------------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME

# --- MQTT (mêmes mots de passe que dans infra/mosquitto/passwd) --------------
MQTT_API_PASSWORD=CHANGE_ME
MQTT_ANOMALY_PASSWORD=CHANGE_ME
MQTT_VISION_PASSWORD=CHANGE_ME
MQTT_NOTIFY_PASSWORD=CHANGE_ME                # service de notifications (ai/notify, sur le PC)

# --- API ---------------------------------------------------------------------
API_KEY=CHANGE_ME_32_CARACTERES_MINIMUM        # services -> POST /api/v1/alerts
OPERATOR_TOKEN=CHANGE_ME_32_CARACTERES_MINIMUM # interface opérateur
WEBHOOK_URL=                                   # optionnel, incidents vers une supervision externe

# --- Notifications : mails d'alerte (ai/notify) ------------------------------
# Vide = annonces vocales seulement. Gmail : smtp.gmail.com, 587, et un « mot de passe d'application »
# (compte Google > Sécurité > Validation en deux étapes > Mots de passe des applications), pas le mot de passe du compte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_TO=                                     # destinataires, séparés par des virgules (propriétaires du site)

# --- Vision ------------------------------------------------------------------
# Windows : la vision tourne sur le PC ; tools\demarrer.ps1 lit ces valeurs.
VISION_SOURCE=0                                # index de la webcam (0, 1...) ou chemin d'une vidéo de démo
VISION_MODEL=yolov8n.pt                        # Windows : yolov8n.pt ; Raspberry Pi : yolov8n_ncnn_model
# Linux / Raspberry Pi uniquement (docker-compose.linux.yml)
CAMERA_DEVICE=/dev/video0

# --- Certificats : GID du groupe qui peut lire les clés (Linux / Raspberry Pi) -
CERTS_GID=2000
